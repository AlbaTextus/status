{
  "name": "status",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npm run cf:preview",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:auth": "playwright test --config=temp/playwright.config.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "wrangler dev --test-scheduled --persist-to ../temps/status/cloudflare-state",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:check": "wrangler deploy --dry-run --outdir ../release/status/worker",
    "db:create": "wrangler d1 create albatextus-status",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to ../temps/status/cloudflare-state",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:import": "node scripts/import-json.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "oauth4webapi": "^3.8.8",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.130.0"
  }
}
